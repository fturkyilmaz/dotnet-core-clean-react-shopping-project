# Shopping Project API Environment Variables
# Copy this file to .env and fill in your actual values

# JWT Configuration
JWT_SECRET=YourSuperSecretKeyHere_MustBeAtLeast32CharactersLong_ChangeThis
JWT_ISSUER=ShoppingProject
JWT_AUDIENCE=ShoppingProject
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# API Key
API_KEY=your-super-secret-api-key-change-this-in-production

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ShoppingProjectDb
DB_USER=postgres
DB_PASSWORD=CHANGE_THIS_PASSWORD

# Audit Database
AUDIT_DB_HOST=localhost
AUDIT_DB_PORT=5432
AUDIT_DB_NAME=AuditDb
AUDIT_DB_USER=postgres
AUDIT_DB_PASSWORD=CHANGE_THIS_PASSWORD

# Redis Configuration
REDIS_CONNECTION=localhost:6379,abortConnect=false

# RabbitMQ Configuration
RABBITMQ_CONNECTION=amqp://guest:guest@localhost:5672/
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=CHANGE_THIS_PASSWORD

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=CHANGE_THIS_PASSWORD
EMAIL_ENABLE_SSL=true

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,yourdomain.com,api.yourdomain.com

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourdomain.com

# Consul Configuration
CONSUL_HOST=http://localhost:8500

# Elasticsearch Configuration
ELASTICSEARCH_URL=http://localhost:9200

# Serilog Configuration
LOG_LEVEL=Debug
